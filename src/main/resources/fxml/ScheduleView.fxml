<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.timetable.controller.ScheduleController"
      spacing="20" style="-fx-padding:0;">

    <VBox spacing="4">
        <Label text="Class Schedule" styleClass="section-title"/>
        <Label text="Assign subjects, teachers and rooms to day/period slots" styleClass="section-subtitle"/>
    </VBox>

    <!-- Form Card -->
    <VBox styleClass="form-card" spacing="14">
        <Label text="Create / Edit Schedule Entry" styleClass="field-label"/>

        <!-- Row 1 -->
        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Class / Section *" styleClass="field-label"/>
                <TextField fx:id="classNameField" promptText="e.g. CSE-A" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Subject *" styleClass="field-label"/>
                <ComboBox fx:id="subjectCombo" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Teacher *" styleClass="field-label"/>
                <ComboBox fx:id="teacherCombo" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <!-- Row 2 -->
        <HBox spacing="12">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Classroom *" styleClass="field-label"/>
                <ComboBox fx:id="classroomCombo" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Working Day *" styleClass="field-label"/>
                <ComboBox fx:id="dayCombo" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Time Period *" styleClass="field-label"/>
                <ComboBox fx:id="periodCombo" maxWidth="Infinity"/>
            </VBox>
        </HBox>

        <HBox spacing="10">
            <Button fx:id="saveBtn" text="💾  Save" styleClass="button,accent-btn" onAction="#save"/>
            <Button fx:id="updateBtn" text="✏  Update" styleClass="button,warning-btn" onAction="#update" disable="true"/>
            <Button fx:id="deleteBtn" text="🗑  Delete" styleClass="button,danger-btn" onAction="#delete" disable="true"/>
            <Button text="✖  Clear" styleClass="button" onAction="#clear"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="🔄  Refresh" styleClass="button" onAction="#loadTable"/>
        </HBox>
        <Label fx:id="messageLabel" styleClass="text-danger" wrapText="true" managed="false" visible="false"/>
    </VBox>

    <!-- Table -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="All Schedule Entries" styleClass="field-label"/>
        <TableView fx:id="scheduleTable" VBox.vgrow="ALWAYS" onMouseClicked="#onRowSelect">
            <columns>
                <TableColumn text="Class" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="className"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Subject" prefWidth="180">
                    <cellValueFactory><PropertyValueFactory property="subjectName"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Teacher" prefWidth="160">
                    <cellValueFactory><PropertyValueFactory property="teacherName"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Room" prefWidth="90">
                    <cellValueFactory><PropertyValueFactory property="roomNumber"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Day" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="dayName"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Period" prefWidth="180">
                    <cellValueFactory><PropertyValueFactory property="periodInfo"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder><Label text="No schedule entries yet." styleClass="text-muted"/></placeholder>
        </TableView>
    </VBox>
</VBox>
