<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.timetable.controller.MainController"
      stylesheets="@../css/styles.css"
      spacing="0">

    <!-- ═══ HEADER BAR ═══ -->
    <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="2">
            <Label text="🗓" style="-fx-font-size:28px;"/>
        </VBox>
        <VBox spacing="2" HBox.hgrow="ALWAYS">
            <Label text="Automatic Class Timetable Generator" styleClass="app-title"/>
            <Label text="Smart scheduling for educational institutions" styleClass="app-subtitle"/>
        </VBox>
        <!-- Portal Toggle Buttons -->
        <HBox spacing="8" alignment="CENTER_RIGHT">
            <Button fx:id="adminBtn" text="⚙  Admin Portal" styleClass="portal-btn,portal-btn-active"
                    onAction="#showAdmin" maxHeight="36"/>
            <Button fx:id="userBtn" text="🔍  User Portal" styleClass="portal-btn"
                    onAction="#showUser" maxHeight="36"/>
        </HBox>
    </HBox>

    <!-- ═══ MAIN CONTENT (dynamic) ═══ -->
    <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS">
        <!-- Initially loaded by controller -->
    </StackPane>

    <!-- ═══ STATUS BAR ═══ -->
    <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="12">
        <Label text="●" style="-fx-text-fill:#22c55e; -fx-font-size:10px;"/>
        <Label fx:id="statusLabel" text="Connected to timetable_db" styleClass="status-text"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="v1.0.0" styleClass="status-text"/>
    </HBox>
</VBox>
