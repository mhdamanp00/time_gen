<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.timetable.controller.ClassroomController"
      spacing="20" style="-fx-padding:0;">

    <VBox spacing="4">
        <Label text="Classrooms" styleClass="section-title"/>
        <Label text="Manage physical rooms and their seating capacities" styleClass="section-subtitle"/>
    </VBox>

    <VBox styleClass="form-card" spacing="14">
        <Label text="Add / Edit Classroom" styleClass="field-label"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Room Number *" styleClass="field-label"/>
                <TextField fx:id="roomNumberField" promptText="e.g. A-101" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Capacity *" styleClass="field-label"/>
                <TextField fx:id="capacityField" promptText="e.g. 60" prefWidth="120"/>
            </VBox>
        </HBox>
        <HBox spacing="10">
            <Button fx:id="saveBtn" text="💾  Save" styleClass="button,accent-btn" onAction="#save"/>
            <Button fx:id="updateBtn" text="✏  Update" styleClass="button,warning-btn" onAction="#update" disable="true"/>
            <Button fx:id="deleteBtn" text="🗑  Delete" styleClass="button,danger-btn" onAction="#delete" disable="true"/>
            <Button text="✖  Clear" styleClass="button" onAction="#clear"/>
        </HBox>
        <Label fx:id="messageLabel" styleClass="text-danger" wrapText="true" managed="false" visible="false"/>
    </VBox>

    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="All Classrooms" styleClass="field-label"/>
        <TableView fx:id="classroomTable" VBox.vgrow="ALWAYS" onMouseClicked="#onRowSelect">
            <columns>
                <TableColumn text="ID" prefWidth="60">
                    <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Room Number" prefWidth="200">
                    <cellValueFactory><PropertyValueFactory property="roomNumber"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Capacity" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="capacity"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder><Label text="No classrooms yet." styleClass="text-muted"/></placeholder>
        </TableView>
    </VBox>
</VBox>
