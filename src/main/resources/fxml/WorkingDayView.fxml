<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.timetable.controller.WorkingDayController"
      spacing="20" style="-fx-padding:0;">

    <VBox spacing="4">
        <Label text="Working Days" styleClass="section-title"/>
        <Label text="Define which days are active teaching days" styleClass="section-subtitle"/>
    </VBox>

    <VBox styleClass="form-card" spacing="14">
        <Label text="Add / Edit Working Day" styleClass="field-label"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Day Name *" styleClass="field-label"/>
                <TextField fx:id="dayNameField" promptText="e.g. Monday" maxWidth="Infinity"/>
            </VBox>
        </HBox>
        <HBox spacing="10">
            <Button fx:id="saveBtn" text="💾  Save" styleClass="button,accent-btn" onAction="#save"/>
            <Button fx:id="updateBtn" text="✏  Update" styleClass="button,warning-btn" onAction="#update" disable="true"/>
            <Button fx:id="deleteBtn" text="🗑  Delete" styleClass="button,danger-btn" onAction="#delete" disable="true"/>
            <Button text="✖  Clear" styleClass="button" onAction="#clear"/>
        </HBox>
        <Label fx:id="messageLabel" styleClass="text-danger" wrapText="true" managed="false" visible="false"/>
    </VBox>

    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="All Working Days" styleClass="field-label"/>
        <TableView fx:id="dayTable" VBox.vgrow="ALWAYS" onMouseClicked="#onRowSelect">
            <columns>
                <TableColumn text="ID" prefWidth="80">
                    <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Day Name" prefWidth="300">
                    <cellValueFactory><PropertyValueFactory property="dayName"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder><Label text="No working days yet." styleClass="text-muted"/></placeholder>
        </TableView>
    </VBox>
</VBox>
