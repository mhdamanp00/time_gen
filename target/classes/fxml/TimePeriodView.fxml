<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.timetable.controller.TimePeriodController"
      spacing="20" style="-fx-padding:0;">

    <VBox spacing="4">
        <Label text="Time Periods" styleClass="section-title"/>
        <Label text="Define daily time slots / periods" styleClass="section-subtitle"/>
    </VBox>

    <VBox styleClass="form-card" spacing="14">
        <Label text="Add / Edit Time Period" styleClass="field-label"/>
        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="6">
                <Label text="Period Number *" styleClass="field-label"/>
                <TextField fx:id="periodNumberField" promptText="e.g. 1" prefWidth="120"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Start Time * (HH:mm)" styleClass="field-label"/>
                <TextField fx:id="startTimeField" promptText="09:00" prefWidth="140"/>
            </VBox>
            <VBox spacing="6">
                <Label text="End Time * (HH:mm)" styleClass="field-label"/>
                <TextField fx:id="endTimeField" promptText="09:50" prefWidth="140"/>
            </VBox>
        </HBox>
        <HBox spacing="10">
            <Button fx:id="saveBtn" text="💾  Save" styleClass="button,accent-btn" onAction="#save"/>
            <Button fx:id="updateBtn" text="✏  Update" styleClass="button,warning-btn" onAction="#update" disable="true"/>
            <Button fx:id="deleteBtn" text="🗑  Delete" styleClass="button,danger-btn" onAction="#delete" disable="true"/>
            <Button text="✖  Clear" styleClass="button" onAction="#clear"/>
        </HBox>
        <Label fx:id="messageLabel" styleClass="text-danger" wrapText="true" managed="false" visible="false"/>
    </VBox>

    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="All Time Periods" styleClass="field-label"/>
        <TableView fx:id="periodTable" VBox.vgrow="ALWAYS" onMouseClicked="#onRowSelect">
            <columns>
                <TableColumn text="Period #" prefWidth="90">
                    <cellValueFactory><PropertyValueFactory property="periodNumber"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="Start Time" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="startTime"/></cellValueFactory>
                </TableColumn>
                <TableColumn text="End Time" prefWidth="150">
                    <cellValueFactory><PropertyValueFactory property="endTime"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder><Label text="No time periods yet." styleClass="text-muted"/></placeholder>
        </TableView>
    </VBox>
</VBox>
