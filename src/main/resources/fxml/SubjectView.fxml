<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.control.cell.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.timetable.controller.SubjectController"
      spacing="20" style="-fx-padding:0;">

    <!-- Title -->
    <VBox spacing="4">
        <Label text="Subjects" styleClass="section-title"/>
        <Label text="Add each course once. Assign teachers to subjects before building the timetable."
               styleClass="section-subtitle" wrapText="true"/>
    </VBox>

    <!-- Form Card -->
    <VBox styleClass="form-card" spacing="14">
        <Label fx:id="formTitle" text="Add a subject" styleClass="field-label"/>
        <Label text="To edit or delete a subject, select its row in the list below."
               styleClass="text-muted" wrapText="true"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Subject Name *" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="e.g. Data Structures" maxWidth="Infinity"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Code *" styleClass="field-label"/>
                <TextField fx:id="codeField" promptText="e.g. CS301" prefWidth="140"/>
            </VBox>
            <VBox spacing="6">
                <Label text="Credits *" styleClass="field-label"/>
                <TextField fx:id="creditsField" promptText="e.g. 4" prefWidth="100"/>
            </VBox>
        </HBox>

        <!-- Action Buttons -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button fx:id="saveBtn" text="Add subject" styleClass="button,accent-btn" onAction="#save"/>
            <Button fx:id="updateBtn" text="Save changes" styleClass="button,warning-btn" onAction="#update" disable="true"/>
            <Button fx:id="deleteBtn" text="Delete selected" styleClass="button,danger-btn" onAction="#delete" disable="true"/>
            <Button text="Clear form" styleClass="button" onAction="#clear"/>
        </HBox>

        <!-- Validation message -->
        <Label fx:id="messageLabel" styleClass="text-danger" wrapText="true" managed="false" visible="false"/>
    </VBox>

    <!-- Table -->
    <VBox spacing="8" VBox.vgrow="ALWAYS">
        <Label text="All Subjects" styleClass="field-label"/>
        <TableView fx:id="subjectTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="60">
                    <cellValueFactory><PropertyValueFactory property="id"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colName" text="Name" prefWidth="280">
                    <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colCode" text="Code" prefWidth="120">
                    <cellValueFactory><PropertyValueFactory property="code"/></cellValueFactory>
                </TableColumn>
                <TableColumn fx:id="colCredits" text="Credits" prefWidth="100">
                    <cellValueFactory><PropertyValueFactory property="credits"/></cellValueFactory>
                </TableColumn>
            </columns>
            <placeholder><Label text="No subjects yet. Add one above." styleClass="text-muted"/></placeholder>
        </TableView>
    </VBox>
</VBox>
