<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<HBox xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.timetable.controller.AdminDashboardController"
      VBox.vgrow="ALWAYS">

    <!-- ═══ SIDEBAR ═══ -->
    <VBox styleClass="sidebar" spacing="2">
        <Label text="SET UP" styleClass="sidebar-section-label"/>

        <Button fx:id="btnSubject" text="📚  Subjects" styleClass="sidebar-btn,sidebar-btn-active"
                onAction="#showSubjects" maxWidth="Infinity"/>
        <Button fx:id="btnTeacher" text="👨‍🏫  Teachers" styleClass="sidebar-btn"
                onAction="#showTeachers" maxWidth="Infinity"/>
        <Button fx:id="btnClassroom" text="🏫  Classrooms" styleClass="sidebar-btn"
                onAction="#showClassrooms" maxWidth="Infinity"/>
        <Button fx:id="btnWorkingDay" text="📅  Working Days" styleClass="sidebar-btn"
                onAction="#showWorkingDays" maxWidth="Infinity"/>
        <Button fx:id="btnTimePeriod" text="⏰  Time Periods" styleClass="sidebar-btn"
                onAction="#showTimePeriods" maxWidth="Infinity"/>

        <Separator style="-fx-padding:8 16;"/>
        <Label text="BUILD TIMETABLE" styleClass="sidebar-section-label"/>

        <Button fx:id="btnSchedule" text="🗓  Class Schedule" styleClass="sidebar-btn"
                onAction="#showSchedule" maxWidth="Infinity"/>
        <Button fx:id="btnAutoGenerate" text="⚡  Auto Generate" styleClass="sidebar-btn"
                onAction="#showAutoGenerate" maxWidth="Infinity"/>
    </VBox>

    <!-- ═══ CONTENT PANE ═══ -->
    <StackPane fx:id="adminContentPane" HBox.hgrow="ALWAYS" styleClass="content-area"/>
</HBox>
